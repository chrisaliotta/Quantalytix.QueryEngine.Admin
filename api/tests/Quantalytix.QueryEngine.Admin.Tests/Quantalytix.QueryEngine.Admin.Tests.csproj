<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Quantalytix.QueryEngine.Admin.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <!-- The schema DDL the records must mirror is the seed kit's generated build script. -->
    <SchemaDdlPath>$(SeedKitRoot)ddl_srdb_bi_v2_19.sql</SchemaDdlPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Quantalytix.QueryEngine.Admin.Api/Quantalytix.QueryEngine.Admin.Api.csproj" />
    <ProjectReference Include="../../src/Quantalytix.QueryEngine.Admin.Application/Quantalytix.QueryEngine.Admin.Application.csproj" />
    <ProjectReference Include="../../src/Quantalytix.QueryEngine.Admin.Infrastructure.StarRocks/Quantalytix.QueryEngine.Admin.Infrastructure.StarRocks.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(SchemaDdlPath)" Link="Schema/ddl_srdb_bi.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
