<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Quantalytix.QueryEngine.Admin.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- The schema DDL the records must mirror is the seed kit's generated build script. -->
    <SchemaDdlPath>$(SeedKitRoot)ddl_srdb_bi_v2_27.sql</SchemaDdlPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" Version="2.13.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Quantalytix.QueryEngine.Admin.WebApi/Quantalytix.QueryEngine.Admin.WebApi.csproj" />
    <ProjectReference Include="../../src/Quantalytix.QueryEngine.Admin.Application/Quantalytix.QueryEngine.Admin.Application.csproj" />
    <ProjectReference Include="../../src/Quantalytix.QueryEngine.Admin.Infrastructure.StarRocks/Quantalytix.QueryEngine.Admin.Infrastructure.StarRocks.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Always: switching kit revisions can point at a script older than the copy already in the output. -->
    <None Include="$(SchemaDdlPath)" Link="Schema/ddl_srdb_bi.sql" CopyToOutputDirectory="Always" />
    <!-- The contract and the document the WebApi build generates, which ContractConformanceTests compare. -->
    <None Include="../../openapi/contract/bundled.yaml" Link="OpenApi/bundled.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../openapi/admin-api.json" Link="OpenApi/admin-api.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
