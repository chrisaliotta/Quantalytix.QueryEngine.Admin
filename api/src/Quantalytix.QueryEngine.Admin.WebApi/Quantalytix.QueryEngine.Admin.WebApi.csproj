<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Quantalytix.QueryEngine.Admin.WebApi</RootNamespace>
    <UserSecretsId>Quantalytix.QueryEngine.Admin.WebApi.Development</UserSecretsId>
    <!-- The OpenAPI document is written at build time; the web project generates its client types from it. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name admin-api</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Latest 2.x. Microsoft.AspNetCore.OpenApi 10 accepts [2.12.2, 3.0.0). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.13.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Quantalytix.QueryEngine.Admin.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Quantalytix.QueryEngine.Admin.Application/Quantalytix.QueryEngine.Admin.Application.csproj" />
    <ProjectReference Include="../Quantalytix.QueryEngine.Admin.Infrastructure.StarRocks/Quantalytix.QueryEngine.Admin.Infrastructure.StarRocks.csproj" />
  </ItemGroup>
</Project>
